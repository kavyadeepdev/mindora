{
  "name": "mindora",
  "private": true,
  "description": "Mindora monorepo",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "dev:frontend": "turbo dev --filter=@mindora/frontend",
    "build:frontend": "turbo build --filter=@mindora/frontend",
    "lint:frontend": "turbo lint --filter=@mindora/frontend",
    "dev:backend": "turbo dev --filter=@mindora/backend",
    "build:backend": "turbo build --filter=@mindora/backend",
    "lint:backend": "turbo lint --filter=@mindora/backend",
    "db:docker:up": "docker compose up -d",
    "db:docker:down": "docker compose down",
    "db:docker:logs": "docker compose logs -f db",
    "db:push": "bun run --cwd backend db:push",
    "db:seed": "bun run --cwd backend db:seed",
    "dev:ai": "uvicorn ai_service.main:app --host 0.0.0.0 --port 8000 --reload",
    "ai:train": "python3 ai_service/train.py"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3"
  }
}
