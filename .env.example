# ==============================================================================
# Mindora Environment Configuration Template
# Copy this file to .env (or backend/.env) and configure for your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (Choose OPTION A for Local Docker, or OPTION B for Neon)
# ------------------------------------------------------------------------------

# OPTION A: Local Docker PostgreSQL (Default for local development)
# Run `bun run db:docker:up` to start the PostgreSQL container.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/mindora"

# If port 5432 is already occupied by a local postgres daemon on your machine:
# Set POSTGRES_PORT=5433 here, and change the port in DATABASE_URL:
# POSTGRES_PORT=5433
# DATABASE_URL="postgres://postgres:postgres@localhost:5433/mindora"

# OPTION B: Neon Serverless PostgreSQL (Cloud production/preview)
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Better Auth Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and encryption (min 32 characters)
BETTER_AUTH_SECRET="mindora_super_secret_session_key_32_characters_minimum"

# Base URL where Better Auth / Fastify backend is accessible
BETTER_AUTH_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 3. Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# 4. Optional Services (AI Recommendation Microservice)
# ------------------------------------------------------------------------------
FASTAPI_SERVICE_URL="http://localhost:8000"
