# Server configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (Neon PostgreSQL connection string)
# Example: postgresql://username:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/mindora?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=mindora_better_auth_super_secret_development_key_change_in_prod
BETTER_AUTH_URL=http://localhost:4000

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# FastAPI AI Recommendation Service (Optional / Future service)
FASTAPI_SERVICE_URL=http://localhost:8000
