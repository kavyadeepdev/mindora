# ==============================================================================
# Mindora Backend Environment Configuration
# ==============================================================================

# Local Docker PostgreSQL:
DATABASE_URL="postgres://postgres:postgres@localhost:5432/mindora"

# Or Neon Cloud Serverless PostgreSQL:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth Secret (min 32 characters)
BETTER_AUTH_SECRET="mindora_super_secret_session_key_32_characters_minimum"
BETTER_AUTH_URL="http://localhost:4000"

PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
FASTAPI_SERVICE_URL="http://localhost:8000"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
